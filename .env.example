# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one)
# Gemini 2.0 Flash (recommended, cheapest)
GEMINI_API_KEY=
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Auto-Apply (optional)
# For CAPTCHA solving during auto-apply
CAPSOLVER_API_KEY=

# Screening-question Discord bot (optional)
# Native site handlers ask you screening questions over Discord instead of
# burning Claude tokens on them -- answers are cached (and reusable via
# aliases) so you're only asked once. See README > Screening Questions.
# DISCORD_BOT_TOKEN=      # Bot tab -> Reset Token, at discord.com/developers/applications
# DISCORD_USER_ID=        # Your Discord user ID (enable Developer Mode -> right-click your name -> Copy User ID)
# If Discord isn't configured (or its token fails), questions fall back
# automatically to a local HTTP prompt -- no setup needed. Default port
# 8765; only change this if that port is already taken on your machine.
# SCREENING_PROMPT_PORT=8765

# Gmail response tracking (optional)
# Lets `applypilot gmail sync` detect rejections/interviews/ghosting and
# update the Status column in your Excel tracker automatically.
# Set up with `applypilot gmail auth` -- it fills these in for you.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
